# --- Required ---

# Postgres connection string. Free options: Neon (neon.tech) or Supabase.
DATABASE_URL=

# Password for the manager portal.
ADMIN_PASSWORD=

# --- Optional ---

# Days after the due date before an invoice counts as overdue. Default: 5
GRACE_DAYS=

# Flat late fee (in dollars) applied once when an invoice goes overdue. Default: 50
LATE_FEE=
